# Root CA identity and file naming
ROOT_CA_NAME=my-root-ca

# Root CA distinguished name fields
ROOT_CA_COUNTRY=US
ROOT_CA_STATE=California
ROOT_CA_LOCALITY=San Francisco
ROOT_CA_ORGANIZATION=My Company
ROOT_CA_ORGANIZATIONAL_UNIT=IT Department
ROOT_CA_COMMON_NAME=My Local Root CA
ROOT_CA_VALIDITY_DAYS=3650

# Optional passphrase to encrypt the Root CA private key (leave empty for none)
ROOT_CA_PASSPHRASE=

# SSL certificate identity and file naming
CERT_NAME=my-local-cert

# SSL certificate distinguished name fields
CERT_COUNTRY=US
CERT_STATE=California
CERT_LOCALITY=San Francisco
CERT_ORGANIZATION=My Company
CERT_ORGANIZATIONAL_UNIT=Web Services
CERT_COMMON_NAME=localhost

# Subject Alternative Names (SAN), separated by commas
# IP addresses in this list are auto-detected and added as IP SAN entries
CERT_DNS_NAMES=localhost,*.localhost,127.0.0.1

# Optional additional IP SAN entries, separated by commas
CERT_IP_ADDRESSES=

# SSL certificate validity in days
CERT_VALIDITY_DAYS=365

# Key algorithm: ec or rsa
KEY_TYPE=ec

# Key size written by the web UI and read by make certs.
# EC: 256 (P-256 / prime256v1), 384 (P-384 / secp384r1), or 521 (P-521 / secp521r1).
# RSA: 2048, 3072, or 4096. The chosen size is used for the certificate and for a new Root CA.
# Leave empty to keep the historical default: P-256, or a 4096-bit RSA Root CA and a 2048-bit RSA certificate.
KEY_SIZE=256

# Overwrite an existing certificate with the same CERT_NAME: yes or no
FORCE_REGENERATE=no

# Export a PKCS#12 (.p12) bundle: yes or no
EXPORT_P12=yes

# Password used for the exported .p12 file
P12_PASSWORD=changeit

# Web UI bind address and port (localhost only)
WEBUI_BIND=127.0.0.1
WEBUI_PORT=8443